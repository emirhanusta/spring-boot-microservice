# Copy to .env (git-ignored) and adjust. Dev defaults only - never use in shared environments.

# --- Postgres (one container, one database + role per service) ---
POSTGRES_PORT=5433            # host port; 5433 avoids clashing with a local Postgres on 5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IDENTITY_DB_PASSWORD=identity
CATALOG_DB_PASSWORD=catalog
REVIEW_DB_PASSWORD=review
NOTIFICATION_DB_PASSWORD=notification
LOAN_DB_PASSWORD=loan
CATALOG_QUERY_DB_PASSWORD=catalog_query

# --- Kafka (KRaft, single node) ---
# Any base64-encoded 16-byte UUID; generate with: docker run --rm apache/kafka:4.3.2 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Grafana (obs profile) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- apps profile (docker compose --profile apps; see `make apps-build` / `make up`) ---
GATEWAY_PORT=8080                         # host port of the gateway
KEYS_DIR=./.local/keys                    # mounted read-only into identity-service (create with `make dev-keys`)
APPS_JAVA_OPTS=-XX:MaxRAMPercentage=75    # JVM flags of every service container (mem_limit is 384m)
